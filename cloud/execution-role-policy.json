{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow", "Action":["s3:GetBucketLocation","s3:ListBucket"], "Resource":"arn:aws:s3:::yuvaraj-choicefit-training"},
    {"Effect":"Allow", "Action":["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:AbortMultipartUpload"], "Resource":"arn:aws:s3:::yuvaraj-choicefit-training/choicefit/*"},
    {"Effect":"Allow", "Action":"ecr:GetAuthorizationToken", "Resource":"*"},
    {"Effect":"Allow", "Action":["ecr:BatchCheckLayerAvailability","ecr:GetDownloadUrlForLayer","ecr:BatchGetImage"], "Resource":"arn:aws:ecr:us-east-1:763104351884:repository/pytorch-training"},
    {"Effect":"Allow", "Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents","logs:DescribeLogStreams"], "Resource":"arn:aws:logs:us-east-1:612242785639:log-group:/aws/sagemaker/TrainingJobs*"}
  ]
}
